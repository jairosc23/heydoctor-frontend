# Plantilla E2E — copiar a .env.e2e (no commitear)
# Phase 4.9.1 — Staging Activation & Runtime E2E

# URL preview/staging Vercel (con flags workspace ON en build)
E2E_BASE_URL=https://your-preview-url.vercel.app

# Credenciales médico staging
E2E_DOCTOR_EMAIL=
E2E_DOCTOR_PASSWORD=

# UUIDs consultas seed en staging (crear manualmente o vía API)
E2E_CONSULTATION_HTA=
E2E_CONSULTATION_DM2=
E2E_CONSULTATION_ACUTE=
E2E_CONSULTATION_PAYMENT=
