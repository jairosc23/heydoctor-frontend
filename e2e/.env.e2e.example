# Phase 19.2 — Plantilla E2E (copiar a .env.e2e en raíz del repo)
# Contrato: ADR-019 Clinical Workspace Observability Contract

# ── OBLIGATORIO (gl-07) ─────────────────────────────────────
# URL preview Vercel post-merge 19.1 (build con flags workspace ON). Sin trailing slash.
E2E_BASE_URL=https://heydoctor-frontend-f37eg1u9o-heydoctors-projects.vercel.app

# Credenciales médico con acceso panel staging/preview
E2E_DOCTOR_EMAIL=admin2@heydoctor.health
E2E_DOCTOR_PASSWORD=12345678

# ── CASOS P0 — UUID consultas en staging (gl-08..gl-11) ─────
# P0-1 / gl-08: paciente memoria I10/HTA, consulta draft o in_progress
E2E_CONSULTATION_HTA=153e8214-53b9-4b20-90d5-59d47d0017eb

# P0-2 / gl-09: paciente E11/DM2, consulta in_progress
E2E_CONSULTATION_DM2=2c24c10e-f0fd-4196-b814-3a715a47cc42

# P0-3 / gl-10: paciente nuevo sin memoria crónica, consulta draft
E2E_CONSULTATION_ACUTE=77526572-3a78-4b43-b771-8089f5ae3c52

# P0-4 / gl-11: consulta status signed + Payku sandbox backend
E2E_CONSULTATION_PAYMENT=4a410f1e-ece1-494e-b954-337336ff8c65

# ── VERIFICACIÓN PREVIA (Vercel Preview — ADR-019) ─────────
# NEXT_PUBLIC_CLINICAL_ACTION_WORKSPACE=1
# NEXT_PUBLIC_SMART_CLINICAL_WORKSPACE=1
# NEXT_PUBLIC_HEYDOCTOR_API_URL=https://pro-api.heydoctor.health (o staging API)
#
# DevTools esperado en consulta desktop xl+:
#   data-clinical-action-workspace="true"
#   data-columns="1"
#   data-smart-workspace="true"
