# Phase 19.2 / PQ-01 — Plantilla E2E (copiar a .env.e2e en raíz del repo)
# Contrato: ADR-019 Clinical Workspace Observability Contract
#
# NUNCA commitear .env.e2e ni credenciales reales.
# Sustituir todos los placeholders antes de ejecutar.

# ── OBLIGATORIO (gl-07) ─────────────────────────────────────
# URL Preview / local (sin trailing slash)
E2E_BASE_URL=https://YOUR_PREVIEW.vercel.app

# Credenciales médico de prueba (staging/preview) — placeholders only
E2E_DOCTOR_EMAIL=doctor@example.com
E2E_DOCTOR_PASSWORD=replace-me

# ── CASOS P0 — UUID consultas en el entorno target (gl-08..gl-11) ─
E2E_CONSULTATION_HTA=00000000-0000-4000-8000-000000000001
E2E_CONSULTATION_DM2=00000000-0000-4000-8000-000000000002
E2E_CONSULTATION_ACUTE=00000000-0000-4000-8000-000000000003
E2E_CONSULTATION_PAYMENT=00000000-0000-4000-8000-000000000004

# ── F2-01 Agenda + Auth (solo triad; no requiere UUIDs de consulta) ─
# npm run test:e2e:f2-01
# CI job e2e-f2-01 usa únicamente E2E_BASE_URL + E2E_DOCTOR_EMAIL + E2E_DOCTOR_PASSWORD
# CRUD Agenda soft-skip si el dataset QA no tiene pacientes (ver F2-05).

# ── OPCIONAL ────────────────────────────────────────────────
# E2E_STRICT=1  # fuerza error si faltan UUIDs (CI ya trata CI=true como strict)

# ── VERIFICACIÓN PREVIA (Vercel Preview — ADR-019) ─────────
# NEXT_PUBLIC_CLINICAL_ACTION_WORKSPACE=1
# NEXT_PUBLIC_SMART_CLINICAL_WORKSPACE=1
# NEXT_PUBLIC_HEYDOCTOR_API_URL=https://your-api.example.com
#
# DevTools esperado en consulta desktop xl+:
#   data-clinical-action-workspace="true"
#   data-columns="1"
#   data-smart-workspace="true"
