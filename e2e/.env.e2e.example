# Phase 4.9.2 — Plantilla E2E (copiar a .env.e2e en raíz del repo)

# ── OBLIGATORIO ─────────────────────────────────────────────
# URL preview Vercel (build con flags workspace ON). Sin trailing slash.
E2E_BASE_URL=https://your-preview-url.vercel.app

# Credenciales médico con acceso panel staging
E2E_DOCTOR_EMAIL=
E2E_DOCTOR_PASSWORD=

# ── CASOS P0 — UUID consultas en staging ───────────────────
# P0-1: paciente memoria I10/HTA, consulta draft o in_progress
E2E_CONSULTATION_HTA=

# P0-2: paciente E11/DM2, consulta in_progress
E2E_CONSULTATION_DM2=

# P0-3: paciente nuevo sin memoria crónica, consulta draft
E2E_CONSULTATION_ACUTE=

# P0-4: consulta status signed + Payku sandbox backend
E2E_CONSULTATION_PAYMENT=

# ── VERIFICACIÓN PREVIA (Vercel Preview) ───────────────────
# NEXT_PUBLIC_CLINICAL_ACTION_WORKSPACE=1
# NEXT_PUBLIC_SMART_CLINICAL_WORKSPACE=1
# NEXT_PUBLIC_HEYDOCTOR_API_URL=https://pro-api.heydoctor.health (o staging API)
