    "frontendRepo": "jairosc23/heydoctor-frontend",
    "backendRepo": "SAVAC-HeyDoctor/heydoctor-backend-pro",
    "frontendBaseline": "99f694f8e57d9b2a31fa3a46b80e58c161f5c780",
