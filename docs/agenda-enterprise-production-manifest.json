  "operational": {
    "guides": [
      "docs/agenda-enterprise-operational-guide.md",
      "docs/agenda-enterprise-deployment-guide.md",
      "docs/agenda-enterprise-recovery-guide.md",
      "docs/agenda-enterprise-maintenance-guide.md",
      "docs/agenda-enterprise-developer-guide.md"
    ],
    "onCallBoundary": "agenda-only; exclude medical-copilot"
