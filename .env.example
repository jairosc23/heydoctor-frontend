# ─────────────────────────────────────────────────────────
# HeyDoctor Frontend — Environment Variables
# Copy to .env.local and fill in values
# ─────────────────────────────────────────────────────────

# ── API (required) ──────────────────────────────────────
# Backend API base URL (must include /api suffix)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── WEBRTC (optional) ───────────────────────────────────
# Override WebRTC signaling URL. If not set, derived from API_URL
# NEXT_PUBLIC_WEBRTC_SIGNALING_URL=

# Override ICE servers endpoint. If not set, uses {API_URL}/webrtc/ice-servers
# NEXT_PUBLIC_ICE_SERVERS_URL=
