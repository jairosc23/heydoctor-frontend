# ─────────────────────────────────────────────────────────
# HeyDoctor Frontend — Environment Variables
# Copy to .env.local and fill in values
# ─────────────────────────────────────────────────────────

# ── API (required in production builds / Vercel) ─────────
# Origen del backend Nest (con o sin /api; se normaliza a .../api para rutas).
# Obligatoria en `next build` con NODE_ENV=production. Ejemplo producción:
NEXT_PUBLIC_HEYDOCTOR_API_URL=https://pro-api.heydoctor.health

# Precio de consulta: Nest GET /api/consultations/consultation-price (CONSULTATION_PAYMENT_AMOUNT_CLP).
# El front usa proxy same-origin GET /api/consultations/consultation-price con Bearer.

# ── Auth (optional) ───────────────────────────────────────
# Segundos antes de exp del access token para disparar silent refresh (cliente). Por defecto 60.
# NEXT_PUBLIC_ACCESS_REFRESH_LEEWAY_SEC=60
# Logs en consola del navegador para depurar exp/leeway (no usar en producción).
# NEXT_PUBLIC_JWT_DEBUG=true
# (JWT_DEBUG=true solo aplica en cliente si lo incluyes en el bundle vía next.config.)

# ── WEBRTC (optional) ───────────────────────────────────
# Override WebRTC signaling URL. If not set, derived from HEYDOCTOR API URL
# NEXT_PUBLIC_WEBRTC_SIGNALING_URL=

# Override ICE servers endpoint. If not set, uses {API_URL}/webrtc/ice-servers
# NEXT_PUBLIC_ICE_SERVERS_URL=

# Consola del navegador: logs de signaling/ICE durante teleconsulta (uso temporal).
# NEXT_PUBLIC_WEBRTC_DEBUG=1

# ── Sentry (optional) ─────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_RELEASE=  # ej. git SHA en Vercel; alinea traces con backend
# SENTRY_RELEASE=

# ── Clinical Workspaces (Phase 4.2 / 4.3 / 4.9.0) ───────────
# Workspace oficial HeyDoctor = ambos flags ON (rebuild obligatorio).
# Default en código: false — prod puede estar en layout legacy hasta activación ops.
# NEXT_PUBLIC_CLINICAL_ACTION_WORKSPACE=1
# NEXT_PUBLIC_SMART_CLINICAL_WORKSPACE=1

# Solo dígitos con código país, sin + (ej. 56912345678)
# NEXT_PUBLIC_WHATSAPP_NUMBER=56912345678
# NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola, quiero agendar una hora con un médico en HeyDoctor.

# ── HCX Phase 12 Foundation (Primitive + Foundation only) ─
# Enables /dev/hcx-foundation showcase and HcxFoundationGate.
# Never disables COS HAB/context fail-closed.
# NEXT_PUBLIC_HCX_FOUNDATION=true

# ── HCX Phase 13 Workspace Shell (structural chrome only) ─
# Enables /dev/hcx-workspace-shell. No clinical / HAB / emission UI.
# NEXT_PUBLIC_HCX_WORKSPACE_SHELL=true

# ── HCX Phase 14 Context & Offline Chrome ─
# Enables /dev/hcx-context-shell. Structural context only — no COS data.
# NEXT_PUBLIC_HCX_CONTEXT_SHELL=true
