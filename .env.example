# ─────────────────────────────────────────────────────────
# HeyDoctor Frontend — Environment Variables
# Copy to .env.local and fill in values
# ─────────────────────────────────────────────────────────

# ── API (required) ──────────────────────────────────────
# Origen del backend Nest (con o sin /api; se normaliza a .../api para rutas).
# Producción: https://pro-api.heydoctor.health
NEXT_PUBLIC_HEYDOCTOR_API_URL=https://pro-api.heydoctor.health

# Precio mostrado en funnel paciente / confirmación de pago (CLP, entero).
# NEXT_PUBLIC_CONSULTATION_PRICE_CLP=35000

# ── Auth (optional) ───────────────────────────────────────
# Segundos antes de exp del access token para disparar silent refresh (cliente). Por defecto 60.
# NEXT_PUBLIC_ACCESS_REFRESH_LEEWAY_SEC=60
# Logs en consola del navegador para depurar exp/leeway (no usar en producción).
# NEXT_PUBLIC_JWT_DEBUG=true
# (JWT_DEBUG=true solo aplica en cliente si lo incluyes en el bundle vía next.config.)

# ── WEBRTC (optional) ───────────────────────────────────
# Override WebRTC signaling URL. If not set, derived from HEYDOCTOR API URL
# NEXT_PUBLIC_WEBRTC_SIGNALING_URL=

# Override ICE servers endpoint. If not set, uses {API_URL}/webrtc/ice-servers
# NEXT_PUBLIC_ICE_SERVERS_URL=

# ── WhatsApp (landing: botón + QR para pacientes) ────────
# Solo dígitos con código país, sin + (ej. 56912345678)
# NEXT_PUBLIC_WHATSAPP_NUMBER=56912345678
# NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola, quiero agendar una hora con un médico en HeyDoctor.
