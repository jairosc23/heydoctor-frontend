# ─────────────────────────────────────────────────────────
# HeyDoctor Frontend — Environment Variables
# Copy to .env.local and fill in values
# ─────────────────────────────────────────────────────────

# ── API (required) ──────────────────────────────────────
# Backend API base URL (must include /api suffix)
# Origen del backend (con o sin /api; se normaliza a .../api para Nest)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── WEBRTC (optional) ───────────────────────────────────
# Override WebRTC signaling URL. If not set, derived from API_URL
# NEXT_PUBLIC_WEBRTC_SIGNALING_URL=

# Override ICE servers endpoint. If not set, uses {API_URL}/webrtc/ice-servers
# NEXT_PUBLIC_ICE_SERVERS_URL=

# ── WhatsApp (landing: botón + QR para pacientes) ────────
# Solo dígitos con código país, sin + (ej. 56912345678)
# NEXT_PUBLIC_WHATSAPP_NUMBER=56912345678
# NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola, quiero agendar una hora con un médico en HeyDoctor.
